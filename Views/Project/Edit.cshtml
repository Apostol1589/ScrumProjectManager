@using ScrumProjectManager.Resources
@model ScrumProjectManager.Data.Entities.Project
@{
    ViewData["Title"] = ViewContext.RouteData.Values["action"].ToString() == "Edit" ? Views.Project_Edit : Views.Project_Create;
}
<h2>@ViewData["Title"]</h2>
<form asp-action="@ViewContext.RouteData.Values["action"]" method="post">
    @if (Model.Id != 0)
    {
        <input type="hidden" asp-for="Id" />
    }
    <div class="mb-3">
        <label asp-for="Name" class="form-label">@Views.Project_Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="StartDate" class="form-label">@Views.Project_StartDate</label>
        <input asp-for="StartDate" type="date" class="form-control" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">@Views.Button_Save</button>
    <a asp-action="Index" class="btn btn-secondary">@Views.Button_Back</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}