@model List<ScrumProjectManager.Data.Entities.Project>
@{
    ViewData["Title"] = "Project List";
}

<h2>All Projects</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Create New Project</a>

@if (!Model.Any())
{
    <div class="alert alert-info">No projects found.</div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Start Date</th>
                <th>Sprint Count</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var project in Model)
            {
                <tr>
                    <td>@project.Id</td>
                    <td>@project.Name</td>
                    <td>@project.StartDate.ToShortDateString()</td>
                    <td>@project.Sprints?.Count ?? 0</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@project.Id" class="btn btn-sm btn-warning">Edit</a>
                        <form asp-action="Delete" asp-route-id="@project.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this project?');">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
