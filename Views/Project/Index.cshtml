@model List<ScrumProjectManager.Data.Entities.Project>
@{
    ViewData["Title"] = "Project List";
}

<h2>All Projects</h2>

<a href="/Project/Create" class="btn btn-primary mb-3">Create New Project</a>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No projects found.</div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Sprint Count</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var project in Model)
            {
                <tr>
                    <td>@project.Id</td>
                    <td>@project.Name</td>
                    <td>@project.Sprints?.Count ?? 0</td>
                </tr>
            }
        </tbody>
    </table>
}
