<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Scrum Manager</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">Scrum Manager</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Home" ? "active" : "")" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Project" ? "active" : "")" href="/Project">Projects</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Sprint" ? "active" : "")" href="/Sprint">Sprints</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "User" ? "active" : "")" href="/User">Users</a>
                    </li>

                </ul>

                <a href="@Url.Action("ChangeLanguage", "Home", new { lang = "uk" })">🇺🇦 Українська</a>
                <a href="@Url.Action("ChangeLanguage", "Home", new { lang = "en" })">🇺🇸 English</a>

            </div>
        </div>
    </nav>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="bg-light text-center p-3 mt-5">
        <span class="text-muted">ScrumProjectManager © 2025</span>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
