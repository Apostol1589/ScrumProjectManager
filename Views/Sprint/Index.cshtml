@using ScrumProjectManager.Resources
@model List<ScrumProjectManager.Data.Entities.Sprint>
@{
    ViewData["Title"] = Views.Sprint_Title;
}
<h2>@Views.Sprint_Title</h2>
<a asp-action="Create" class="btn btn-primary mb-3">@Views.Sprint_Create</a>
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>@Views.Sprint_Name</th>
            <th>@Views.Sprint_Start</th>
            <th>@Views.Sprint_End</th>
            <th>@Views.Sprint_Project</th>
            <th>@Views.Project_Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var sprint in Model)
        {
            <tr>
                <td>@sprint.Name</td>
                <td>@sprint.StartDate.ToShortDateString()</td>
                <td>@sprint.EndDate.ToShortDateString()</td>
                <td>@sprint.Project?.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@sprint.Id" class="btn btn-sm btn-warning">@Views.Project_Edit</a>
                    <form asp-action="Delete" asp-route-id="@sprint.Id" method="post" style="display:inline;" onsubmit="return confirm('@Views.Sprint_Delete_Confirm');">
                        <button type="submit" class="btn btn-sm btn-danger">@Views.Project_Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>