@using ScrumProjectManager.Resources
@model List<ScrumProjectManager.Data.Entities.User>
@{
    ViewData["Title"] = Views.User_Title;
}
<h2>@Views.User_Title</h2>
<a asp-action="Create" class="btn btn-primary mb-3">@Views.User_Add</a>
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>@Views.User_FullName</th>
            <th>@Views.User_Role</th>
            <th>@Views.Project_Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Role</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-warning">@Views.Project_Edit</a>
                    <form asp-action="Delete" asp-route-id="@user.Id" method="post" style="display:inline;" onsubmit="return confirm('@Views.User_Delete_Confirm');">
                        <button type="submit" class="btn btn-sm btn-danger">@Views.Project_Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>